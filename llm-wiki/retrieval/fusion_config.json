{
  "version": "fusion-v3",
  "k": 60,
  "pool": 25,
  "per_page_cap": 4,
  "seed_hits": 3,
  "max_fanout": 12,
  "min_hits": 3,
  "span_slack": 8,
  "max_tokens": 8,
  "evidence_per_claim": 3,
  "timeout_s": 20.0,
  "collections": {
    "bm25": ["wiki", "raw"],
    "vec": ["wiki"]
  },
  "streams": {
    "bm25": { "index": ".qmd/ (qmd's project-local index)", "via": "qmd search" },
    "vec": { "index": ".qmd/ (qmd's project-local index)", "via": "qmd query vec: --no-rerank" },
    "graph": { "index": "llm-wiki/states/relationships.jsonl" },
    "state": { "index": "llm-wiki/states/claims.jsonl + observations/" }
  },
  "intents": {
    "factual": {
      "weights": { "bm25": 1.0, "vec": 1.0, "graph": 0.5, "state": 1.0 },
      "hops": 1,
      "history": false
    },
    "structural": {
      "weights": { "bm25": 0.5, "vec": 0.5, "graph": 1.5, "state": 0.75 },
      "hops": 2,
      "history": false
    },
    "historical": {
      "weights": { "bm25": 0.75, "vec": 0.75, "graph": 0.5, "state": 1.5 },
      "hops": 1,
      "history": true
    },
    "exploratory": {
      "weights": { "bm25": 0.75, "vec": 1.5, "graph": 1.0, "state": 0.75 },
      "hops": 2,
      "history": false
    }
  },
  "rerank": {
    "probability": 0.15,
    "authority": 0.05,
    "recency": 0.05,
    "support": 0.05,
    "support_cap": 3
  },
  "floor": { "mrr": 0.485376, "recall": 0.823529 },
  "status_factor": {
    "default": {
      "active": 1.0,
      "stale": 0.8,
      "candidate": 0.8,
      "disputed": 0.7,
      "archived": 0.5,
      "superseded": 0.5,
      "rejected": 0.25
    },
    "historical": {
      "active": 1.0,
      "stale": 1.0,
      "candidate": 0.9,
      "disputed": 0.9,
      "archived": 1.0,
      "superseded": 1.0,
      "rejected": 0.5
    }
  }
}
