# Environment template — copy to `.env` and set your values there.
#
#   cp .env.sample .env
#
# `.env` is gitignored and is loaded automatically by direnv when you cd into
# the repo (see `.envrc`). This file is the committed catalog of every variable
# the repo understands; it holds defaults only, never real values.

# --- qmd (markdown search over llm-wiki/) -------------------------------------

# llama.cpp GPU backend used for embedding, query expansion, and reranking.
# One of: auto | metal | vulkan | cuda | false   (false = CPU only)
QMD_LLAMA_GPU=auto

# Where the CUDA runtime lives — Linux + NVIDIA only, and only when CUDA is not
# already on the system loader path.
#
# qmd embeds through node-llama-cpp (llama.cpp), never PyTorch, so a conda env with
# torch and CUDA installed does nothing for it on its own — the two share no loader
# path. The prebuilt libggml-cuda.so needs libcudart.so.13 and libcublas.so.13 but
# carries RUNPATH `$ORIGIN` only, so unless they are on LD_LIBRARY_PATH the CUDA
# backend fails to load and qmd drops to CPU. Setting QMD_LLAMA_GPU=cuda does not
# fix it: that selects the backend, it does not tell the linker where CUDA is.
#
# Point this at the CUDA env's `targets/<arch>/lib`, not its `lib`. The targets
# directory holds CUDA libraries only; `lib` also ships libstdc++, libtinfo, and
# libssl, which shadow the system copies for every process direnv touches — bash
# starts warning "libtinfo.so.6: no version information available".
#
# Verify with `qmd doctor`:
#   ✓ device probe: GPU cuda; offloading enabled; devices: ...   <- working
#   ⚠ device probe: running on CPU (N math cores)                <- path wrong/unset
#
# Example: LD_LIBRARY_PATH=/home/you/miniconda3/envs/<env>/targets/x86_64-linux/lib
LD_LIBRARY_PATH=

# Models qmd builds the index with. qmd reads .qmd/index.yml and its config
# takes precedence over these variables, so scripts/qmd-setup.sh writes them
# into that file — including on a re-run, which is what applies an edit here.
# The script also downloads any of the three not already in qmd's model cache.
#
# Changing the embedding model invalidates every stored vector: its dimension
# is baked into the index, so a switch means a full re-embed of llm-wiki/
# (`qmd embed -f`).
#
# Leave unset to accept qmd's own defaults, which are much smaller and faster
# but noticeably weaker: embeddinggemma-300M (768d) and Qwen3-Reranker-0.6B.
QMD_EMBED_MODEL=hf:Qwen/Qwen3-Embedding-8B-GGUF/Qwen3-Embedding-8B-Q8_0.gguf
QMD_RERANK_MODEL=hf:giladgd/Qwen3-Reranker-4B-GGUF/Qwen3-Reranker-4B.Q8_0.gguf
QMD_GENERATE_MODEL=hf:tobil/qmd-query-expansion-1.7B-gguf/qmd-query-expansion-1.7B-q8_0.gguf

# --- llm-wiki engine (scripts/llm-wiki/) --------------------------------------

# Who the engine records as running a write when a command carries no --actor.
# The skills always pass --actor, so this only matters for hand-run verbs.
# Shape: (human|agent|routine|process):<slug>   Default: agent:unattributed
LLM_WIKI_ACTOR=

# The qmd binary the retriever calls when it is not on PATH. Unset → PATH.
LLM_WIKI_QMD=
