{
  // Bun's recommended baseline for TypeScript 6/7.
  // https://bun.com/docs/typescript · https://bun.com/docs/typescript-6
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    // Required from TypeScript 6 on: `types` now defaults to [] instead of
    // pulling in every @types/* package, so `Bun` and `bun:test` only resolve
    // when "bun" is listed here explicitly.
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  // Scoped to the repo's actual TypeScript. `allowJs` is on, so the Python
  // venv, the knowledge base, and the search index are excluded explicitly
  // rather than left to the default include.
  "include": [".pi/extensions/**/*.ts"],
  "exclude": ["node_modules", ".venv", "llm-wiki", ".qmd", ".ruff_cache", "dist"]
}
